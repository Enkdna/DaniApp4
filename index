    /* CONTROL DEL JUEGO */
    function startGame() {
      currentIndex = 0;
      currentScore = 0;
      document.getElementById('score-display').innerText = currentScore;

      if (currentMode === 'math') {
        currentQuestions = buildMathPool(selectedSubtopic);
      } else {
        currentQuestions = buildLangPool();
      }

      // En matemáticas mostramos la pizarra grande abajo; en lenguaje la ocultamos para más lectura
      const canvasCard = document.getElementById('canvas-card');
      if (currentMode === 'lang') {
        canvasCard.style.display = 'none';
      } else {
        canvasCard.style.display = 'flex';
      }

      showScreen('game-screen');
      loadQuestion();

      if (currentMode === 'math') {
        setTimeout(setupCanvas, 60);
      }

      startTimer();
    }

    function showScreen(screenId) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(screenId).classList.add('active');
    }

    function goToHome() {
      pauseTimer();
      showScreen('start-screen');
    }

    function loadQuestion() {
      const q = currentQuestions[currentIndex];
      document.getElementById('question-counter').innerText = `${currentIndex + 1}/10`;
      document.getElementById('subject-tag').innerText = q.subject;
      document.getElementById('tip-box').innerHTML = `&#x1F4A1; <strong>Tip para Dani:</strong> ${q.tip}`;
      document.getElementById('question-text').innerText = q.question;

      const passageEl = document.getElementById('reading-passage');
      if (q.passage) {
        passageEl.style.display = 'block';
        passageEl.innerText = q.passage;
      } else {
        passageEl.style.display = 'none';
      }

      const container = document.getElementById('options-container');
      container.innerHTML = '';
      q.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerText = opt;
        btn.onclick = () => handleAnswer(btn, opt, q.correct);
        container.appendChild(btn);
      });

      const prog = (currentIndex / currentQuestions.length) * 100;
      document.getElementById('progress-bar').style.width = `${prog}%`;

      if (currentMode === 'math') {
        clearCanvas();
      }
    }

    function handleAnswer(btn, chosen, correct) {
      const allBtns = document.querySelectorAll('.option-btn');
      allBtns.forEach(b => b.disabled = true);

      if (chosen === correct) {
        btn.classList.add('correct');
        currentScore++;
        document.getElementById('score-display').innerText = currentScore;
        playSoundSuccess();
      } else {
        btn.classList.add('wrong');
        allBtns.forEach(b => {
          if (b.innerText === correct) b.classList.add('correct');
        });
        playSoundError();
      }

      setTimeout(() => {
        currentIndex++;
        if (currentIndex < currentQuestions.length) {
          loadQuestion();
        } else {
          finishGame();
        }
      }, 1600);
    }

    function finishGame() {
      pauseTimer();
      document.getElementById('progress-bar').style.width = `100%`;
      showScreen('end-screen');

      const subName = currentMode === 'math' ? `Matem\u00E1ticas (${selectedSubtopic.toUpperCase()})` : 'Lenguaje y Lectura';
      saveHistory(subName, currentScore);

      const card = document.getElementById('result-card');
      const content = document.getElementById('result-content');

      if (currentScore >= 7) {
        card.className = 'result-card pink-world';
