    /* HISTORIAL */
    function saveHistory(subjectName, scoreVal) {
      try {
        const history = JSON.parse(localStorage.getItem('dani_quiz_history') || '[]');
        const now = new Date();
        const dateStr = now.toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: 'numeric' }) + ' ' + 
                        now.toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' });
        
        history.unshift({
          date: dateStr,
          subject: subjectName,
          score: `${scoreVal}/10`,
          passed: scoreVal >= 7
        });

        if (history.length > 25) history.pop();
        localStorage.setItem('dani_quiz_history', JSON.stringify(history));
      } catch (e) {}
    }

    function showHistory() {
      pauseTimer();
      const tbody = document.getElementById('history-tbody');
      tbody.innerHTML = '';

      try {
        const history = JSON.parse(localStorage.getItem('dani_quiz_history') || '[]');
        if (history.length === 0) {
          tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #9E9E9E; padding: 20px;">A&uacute;n no hay sesiones registradas. &iexcl;Juega una partida para ver tu evoluci&oacute;n!</td></tr>`;
        } else {
          history.forEach(item => {
