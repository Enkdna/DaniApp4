        correct: `X = ${x}`,
        options: shuffle([`X = ${x}`, `X = ${x + 10}`, `X = ${x - 5}`, `X = ${b + a}`])
      };
    }

    /* 2. NUEVO: COMPOSICIÓN Y DESCOMPOSICIÓN ADITIVA */
    function genComposition() {
      const tipo = Math.random() > 0.5 ? 'valor' : 'posicion';
      const um = Math.floor(Math.random() * 8) + 2; // 2 a 9
      const c = Math.floor(Math.random() * 9) + 1;  // 1 a 9
      const d = Math.floor(Math.random() * 9) + 1;  // 1 a 9
      const u = Math.floor(Math.random() * 8) + 1;  // 1 a 8
      const numTotal = um * 1000 + c * 100 + d * 10 + u;

      if (tipo === 'valor') {
        const descr = `${um * 1000} + ${c * 100} + ${d * 10} + ${u}`;
        return {
          subject: "Matem\u00E1ticas \u2022 Descomposici\u00F3n por Valor Posicional",
          tip: "Cada d\u00EDgito vale seg\u00FAn su lugar: UM = miles, C = cientos, D = decenas, U = unidades.",
          passage: null,
          question: `\u00BFCu\u00E1l es la descomposici\u00F3n aditiva del n\u00FAmero ${numTotal}?`,
          correct: descr,
          options: shuffle([
            descr,
            `${um * 100} + ${c * 100} + ${d * 10} + ${u}`,
            `${um * 1000} + ${c * 10} + ${d * 10} + ${u}`,
            `${um * 1000} + ${c * 100} + ${d} + ${u}`
          ])
        };
      } else {
        const descrPos = `${um}UM + ${c}C + ${d}D + ${u}U`;
        return {
          subject: "Matem\u00E1ticas \u2022 Descomposici\u00F3n por Posici\u00F3n",
          tip: `Identifica la posici\u00F3n: ${um} Unidades de Mil, ${c} Centenas, ${d} Decenas, ${u} Unidades.`,
          passage: null,
          question: `\u00BFCu\u00E1l es la descomposici\u00F3n seg\u00FAn la posici\u00F3n de ${numTotal}?`,
          correct: descrPos,
          options: shuffle([
            descrPos,
            `${um}C + ${c}D + ${d}U + ${u}UM`,
            `${um}UM + ${c}D + ${d}C + ${u}U`,
            `${um + 1}UM + ${c}C + ${d}D + ${u}U`
          ])
        };
      }
    }

    function genSum3Digits() {
      const a = Math.floor(Math.random() * 450) + 260;
      const b = Math.floor(Math.random() * 350) + 190;
      const ans = a + b;
      return {
        subject: "Matem\u00E1ticas \u2022 Suma con Reserva",
        tip: "\u00A1Alinea unidades, decenas y centenas en la pizarra y suma la reserva!",
        passage: null,
        question: `Resuelve en tu pizarra: ${a} + ${b} =`,
        correct: ans.toString(),
        options: shuffle([ans.toString(), (ans - 10).toString(), (ans + 100).toString(), (ans + 2).toString()])
      };
    }

    function genSub3Digits() {
      const cent = Math.floor(Math.random() * 4) + 6;
      const uni = Math.floor(Math.random() * 8) + 1;
      const a = cent * 100 + uni; // ceros intermedios ej: 704
      const b = Math.floor(Math.random() * 260) + 240;
      const ans = a - b;
      return {
        subject: "Matem\u00E1ticas \u2022 Resta con Ceros Intermedios",
        tip: "Si el cero no puede prestar, p\u00EDdele a la centena: se vuelve 10 y luego presta.",
        passage: null,
        question: `Resuelve en tu pizarra: ${a} \u2212 ${b} =`,
        correct: ans.toString(),
        options: shuffle([ans.toString(), (ans + 10).toString(), (ans - 100).toString(), (ans + 20).toString()])
      };
    }

    function genMul3Digits() {
      const a = Math.floor(Math.random() * 140) + 130;
      const b = Math.floor(Math.random() * 4) + 3;
      const ans = a * b;
      return {
        subject: "Matem\u00E1ticas \u2022 Multiplicaci\u00F3n de 3 D\u00EDgitos",
        tip: "Multiplica primero unidades, luego decenas y centenas anotando la reserva arriba.",
        passage: null,
        question: `Calcula en la pizarra: ${a} \u00D7 ${b} =`,
        correct: ans.toString(),
        options: shuffle([ans.toString(), (ans + 10).toString(), (ans - 20).toString(), (ans + 5).toString()])
      };
    }

    function genDiv3Digits() {
      const divi = Math.floor(Math.random() * 4) + 3;
      const coci = Math.floor(Math.random() * 70) + 40;
      const divid = divi * coci;
      return {
        subject: "Matem\u00E1ticas \u2022 Divisi\u00F3n de 3 D\u00EDgitos",
        tip: `\u00BFCu\u00E1ntas veces cabe el ${divi} en el dividendo? Usa la tabla del ${divi}.`,
        passage: null,
        question: `Resuelve en la pizarra: ${divid} : ${divi} =`,
        correct: coci.toString(),
        options: shuffle([coci.toString(), (coci + 2).toString(), (coci - 3).toString(), (coci + 10).toString()])
      };
    }

    function genFraction() {
      const den = [4, 6, 8, 10][Math.floor(Math.random() * 4)];
      const n1 = Math.floor(Math.random() * 2) + 1;
      const n2 = Math.floor(Math.random() * (den - 4)) + 1;
      const tot = n1 + n2;
      const ans = `${tot}/${den}`;
      return {
        subject: "Matem\u00E1ticas \u2022 Fracciones",
        tip: "Como tienen igual n\u00FAmero abajo, mant\u00E9n el denominador y suma arriba.",
        passage: null,
        question: `\u00BFCu\u00E1nto es ${n1}/${den} + ${n2}/${den}?`,
        correct: ans,
        options: shuffle([ans, `${tot}/${den * 2}`, `${tot + 1}/${den}`, `${n1}/${den}`])
      };
    }

    function buildMathPool(subtopic) {
      const list = [];
      for (let i = 0; i < 10; i++) {
        if (subtopic === 'ecu') list.push(genEquation());
        else if (subtopic === 'comp') list.push(genComposition());
        else if (subtopic === 'sum') list.push(genSum3Digits());
        else if (subtopic === 'sub') list.push(genSub3Digits());
        else if (subtopic === 'mul') list.push(genMul3Digits());
        else if (subtopic === 'div') list.push(genDiv3Digits());
        else if (subtopic === 'frac') list.push(genFraction());
        else {
          // Mezcladas (incluyendo Ecuaciones y Descomposición)
          if (i === 0 || i === 1) list.push(genEquation());
          else if (i === 2 || i === 3) list.push(genComposition());
          else if (i === 4) list.push(genSum3Digits());
          else if (i === 5) list.push(genSub3Digits());
          else if (i === 6) list.push(genMul3Digits());
          else if (i === 7) list.push(genDiv3Digits());
          else list.push(genFraction());
        }
      }
      return list;
    }

