    /* 1. NUEVO: ECUACIONES DE 4° BÁSICO (X + a = b) */
    function genEquation() {
      // Ejemplos como en la clase de Dani: X + 13 = 45 -> X = 45 - 13 = 32
      const a = Math.floor(Math.random() * 35) + 12; // 12 a 46
      const x = Math.floor(Math.random() * 50) + 10; // 10 a 59
